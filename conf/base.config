/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BortonWrightonLabs/dram Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    resourceLimits = [
        cpus  : params.max_cpus,
        memory: params.max_memory,
        time  : params.max_time
    ]

    // TODO nf-core: Check the defaults for all processes
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // TODO nf-core: Customise requirements for specific processes.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_tiny {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withLabel:process_single {
        cpus   = 1
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_small {
        cpus   = { 4     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_big {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_huge {
        cpus   = { 24     * task.attempt }
        memory = { 200.GB * task.attempt }
        time   = { 168.h  * task.attempt }
    }
    withLabel:process_call_genes {
        cpus   = { (resource_class == 'small' ? 4 : resource_class == 'medium' ? 6 : 24) * task.attempt }
        memory = { (resource_class == 'small' ? 12.GB : resource_class == 'medium' ? 36.GB : 200.GB) * task.attempt }
        time   = { (resource_class == 'small' ? 4.h : resource_class == 'medium' ? 8.h : 168.h) * params.call_batch_size * task.attempt }
    }
    withLabel:process_trna_scan {
        cpus   = { (resource_class == 'small' ? 4 : resource_class == 'medium' ? 6 : 24) * task.attempt }
        memory = { (resource_class == 'small' ? 12.GB : resource_class == 'medium' ? 36.GB : 200.GB) * task.attempt }
        time   = { (resource_class == 'small' ? 4.h : resource_class == 'medium' ? 8.h : 168.h) * params.rna_batch_size * task.attempt }
    }
    withLabel:process_rrna_scan {
        cpus   = { (resource_class == 'small' ? 4 : resource_class == 'medium' ? 6 : 24) * task.attempt }
        memory = { (resource_class == 'small' ? 12.GB : resource_class == 'medium' ? 36.GB : 200.GB) * task.attempt }
        time   = { (resource_class == 'small' ? 4.h : resource_class == 'medium' ? 8.h : 168.h) * params.rna_batch_size * task.attempt }
    }
    withLabel:process_quast {
        cpus   = { (resource_class == 'small' ? 4 : resource_class == 'medium' ? 6 : 24) * task.attempt }
        memory = { (resource_class == 'small' ? 12.GB : resource_class == 'medium' ? 36.GB : 200.GB) * task.attempt }
        time   = { (resource_class == 'small' ? 4.h : resource_class == 'medium' ? 8.h : 168.h) * task.attempt }
    }
    withLabel:process_hmm_search {
        cpus   = { (resource_class == 'small' ? 6 : resource_class == 'medium' ? 12 : 24) * task.attempt }
        memory = { (resource_class == 'small' ? 36.GB : resource_class == 'medium' ? 72.GB : 200.GB) * task.attempt }
        // Use the configured capacity, including for partial batches, so arrays
        // have uniform initial requests. resourceLimits still caps wall time.
        time   = { (resource_class == 'small' ? 8.h : resource_class == 'medium' ? 16.h : 168.h) * params.search_batch_size * task.attempt }
    }
    withLabel:process_mmseqs_search {
        cpus   = { (resource_class == 'small' ? 6 : resource_class == 'medium' ? 12 : 24) * task.attempt }
        memory = { (resource_class == 'small' ? 36.GB : resource_class == 'medium' ? 72.GB : 200.GB) * task.attempt }
        time   = { (resource_class == 'small' ? 8.h : resource_class == 'medium' ? 16.h : 168.h) * params.search_batch_size * task.attempt }
    }
    withLabel:process_array {
        array = params.job_array_size > 1 ? params.job_array_size : 0
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        accelerator      = 1
        // containerOptions = { params.gpu_container_options ?: (workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '-u $(id -u):$(id -g) --gpus all') }
        containerOptions = { params.gpu_container_options ?: (workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '--gpus all') }}
}
