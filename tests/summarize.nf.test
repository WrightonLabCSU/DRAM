nextflow_pipeline {

    name "Test summarize"
    script "../main.nf"
    tag "pipeline"

    test("Test SUMMARIZE") {

        when {
            params {
                outdir = "$outputDir"
                summarize = true
                qc = true
            }
        }


        then {
            assert workflow.success
            def actual = path("${params.outdir}/SUMMARIZE/summarized_genomes.tsv").csv(sep: "\t").sort()
            def expected = path("${projectDir}/tests/data/owc/summarize/summarized_genomes.tsv").csv(sep: "\t")

            assert actual.columns["gene_id"] == expected.columns["gene_id"]
            assert actual.columns["gene_description"] == expected.columns["gene_description"]
            assert actual.columns["OWC_0000"] == expected.columns["OWC_0000"]
            assert actual.columns["OWC_0001"] == expected.columns["OWC_0001"]
            assert actual.columns["topic_ecosystem"] == expected.columns["topic_ecosystem"]
            assert actual.columns["category"] == expected.columns["category"]
            assert actual.columns["subcategory"] == expected.columns["subcategory"]

            def genome_stats_actual = path("${params.outdir}/SUMMARIZE/genome_stats.tsv").csv(sep: "\t").sort()
            def genome_stats_expected = path("${projectDir}/tests/data/owc/summarize/genome_stats.tsv").csv(sep: "\t")

            assert genome_stats_actual.columns["genome"] == genome_stats_expected.columns["genome"]
            assert genome_stats_actual.columns["number of scaffolds"] == genome_stats_expected.columns["number of scaffolds"]
            assert genome_stats_actual.columns["assembly size"] == genome_stats_expected.columns["assembly size"]
            assert genome_stats_actual.columns["largest contig"] == genome_stats_expected.columns["largest contig"]
            assert genome_stats_actual.columns["N50"] == genome_stats_expected.columns["N50"]
            assert genome_stats_actual.columns["L50"] == genome_stats_expected.columns["L50"]
        }
    }
}
