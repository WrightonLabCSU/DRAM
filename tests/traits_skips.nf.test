nextflow_pipeline {

    name "Test Traits Skipping Steps Profile"
    script "../main.nf"
    tag "pipeline"

    test("Test TRAITS skipping steps profile") {

        when {
            params {
                outdir = "$outputDir"
                summarize = false
                qc = false
                traits = true
            }
        }


        then {
            assert workflow.success
        }
    }
}
